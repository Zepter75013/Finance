# Copier ce fichier en ".env" (non versionné) et remplir les valeurs réelles.
# Ce sont les identifiants de la NOUVELLE base/utilisateur créés dans le
# conteneur MySQL existant ("bdd-mysql") pour l'app Finance — pas les
# identifiants de l'app disques (vinyl-*) elle-même.

FINANCE_DB_NAME=financedb
FINANCE_DB_USER=FinanceAdmin
FINANCE_DB_PASSWORD=

FINANCE_ADMIN_USERNAME=
FINANCE_ADMIN_PASSWORD=

# URL publique du frontend (utilisée pour l'en-tête CORS du backend)
FRONTEND_URL=https://finance-qnap.mycloudnas.com

# Optionnel — envoi d'e-mails (réinitialisation de mot de passe)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
